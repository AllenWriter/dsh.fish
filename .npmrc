# Peer dependencies are declared, not auto-installed.
#
# `packages/dsh-plugin-hub` binds to harness packages the *host* supplies at
# runtime (`@deepseek-ai/dsh-tools`, `@deepseek-ai/cordis`). Auto-installing
# them would both pull an unpublished transitive dependency and risk a second
# copy of the tool registry, which the harness explicitly cannot have.
auto-install-peers=false
