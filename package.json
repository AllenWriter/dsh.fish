{
  "name": "dsh-fish",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin hub for DeepSeek Harness: discovery, distribution and one-command install for every dsh artifact type.",
  "scripts": {
    "check": "pnpm -r --parallel run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "pnpm --filter @dsh-fish/frontend run build",
    "dev": "pnpm --filter @dsh-fish/frontend run dev",
    "deploy": "pnpm --filter @dsh-fish/frontend run deploy",
    "db:generate": "pnpm --filter @dsh-fish/backend run db:generate",
    "db:migrate:local": "pnpm --filter @dsh-fish/frontend run db:migrate:local",
    "db:migrate:remote": "pnpm --filter @dsh-fish/frontend run db:migrate:remote",
    "docs:check": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@cloudflare/workers-types": "^5.20260815.1"
    }
  }
}
