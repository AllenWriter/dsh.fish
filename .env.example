# Local development values. Production secrets are set with
# `wrangler secret put <NAME>`, never committed.

# Absolute origin the site is served from.
PUBLIC_BASE_URL=http://localhost:5173

# Better Auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# GitHub OAuth app. Callback URL: <PUBLIC_BASE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Read-only token for the crawler. Public data only; without it the crawler
# still runs, at the far lower anonymous rate limit.
GITHUB_TOKEN=

# Comma-separated account emails granted administrator rights.
ADMIN_EMAILS=

# IndexNow key. Public by design: the Worker serves it at /indexnow-<key>.txt.
# Must match the var in frontend/wrangler.jsonc for submissions to verify.
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=
