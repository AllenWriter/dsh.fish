{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh-fish",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_BASE_URL": "https://dsh.fish"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-fish-db",
      "database_id": "be324981-52bb-4f2d-ae81-bd1583ec146a",
      "migrations_dir": "../backend/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1baebac2338049c0a8294779adde73a7"
    }
  ],
  "triggers": {
    // Re-crawl the GitHub `dsh-plugin` topic and npm every six hours.
    "crons": ["0 */6 * * *"]
  }
}
